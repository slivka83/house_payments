MOSOBLEIRC_PHONE=+79001234567
MOSOBLEIRC_PASSWORD=пароль

# необязательное: готовый X-Auth-Tenant-Token вместо логина
# MOSOBLEIRC_TOKEN=

# необязательные параметры (значения по умолчанию)
# MOSOBLEIRC_HOST=0.0.0.0
# MOSOBLEIRC_PORT=8765
# MOSOBLEIRC_MONTHS=12
# MOSOBLEIRC_VALUE=charged
# MOSOBLEIRC_ACCOUNT=123456789
# MOSOBLEIRC_END_MONTH=2026-08
# MOSOBLEIRC_SHIFT=1
# MOSOBLEIRC_ANCHOR_DAY=15
# MOSOBLEIRC_CACHE_DIR=data/raw
# MOSOBLEIRC_RECEIPTS_DIR=data/receipts
# MOSOBLEIRC_TOKEN_FILE=~/.cache/mosobleirc/token.json
